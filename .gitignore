# Datasets — never commit (huge, and redistributable only from original sources)
data/

# Model weights / checkpoints
*.pth
*.pt
*.ckpt
*.onnx

# Archives
*.zip
*.tar
*.tar.gz

# Cloned baseline repos (we clone them, we don't vendor them)
baselines/*/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.venv/

# OS
.DS_Store

# Enhanced output images (~900 MB) — regenerate with the scripts; keep CSVs/figures
results/**/*.png
results/**/*.jpg

# Logs
*.log
# ...but DO keep figures for the report/slides
!results/figures/
!results/figures/**/*.png
!results/training_logs/*.log
